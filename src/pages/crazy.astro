---
import LayoutNoNav from '../layouts/LayoutNoNav.astro';
---

<LayoutNoNav title="Crazy">
    <svg width="100%" height="100vh" viewBox="0 0 1000 1000" preserveAspectRatio="none">
        {[...Array(50)].map((_, i) => (
            <line x1={i * 50} y1="0" x2={i * 20} y2="1000" stroke="red" stroke-width="1" opacity="0.3" />
        ))}
        {[...Array(50)].map((_, i) => (
            <line x1="0" y1={i * 50} x2={i * 20} y2="1000" stroke="red" stroke-width="1" opacity="0.3" />
        ))}
        {[...Array(50)].map((_, i) => (
            <line x1={i * 20} y1="0" x2="0" y2={i * 20} stroke="red" stroke-width="1" opacity="0.3" />
        ))}
        {[...Array(50)].map((_, i) => (
            <line x1={i * 20} y1={i * 20} x2="0" y2={i * 20} stroke="red" stroke-width="1" opacity="0.3" />
        ))}
    </svg>

</LayoutNoNav>
