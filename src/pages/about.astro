---
import Layout from '../layouts/Layout.astro';

let users = [];
try {
    const response = await fetch('https://randomuser.me/api/?results=10');
    const data = await response.json();
    users = data.results;
} catch (err) {
    console.error('Error fetching user data:', err);
}
---

<Layout title="About">
    <h1>About Us</h1>
    <p>This is the about page of our Astro site.</p>
    <ul id="user-list">
        {users.map((user: any) => (
            <li>{user.name.first} {user.name.last} - {user.email} - {user.location.city}</li>
        ))}
    </ul>
</Layout>